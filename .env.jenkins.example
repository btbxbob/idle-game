JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-this-password
DIND_MEMORY_LIMIT=1536m
DIND_MEMORY_RESERVATION=1024m
JENKINS_MEMORY_LIMIT=416m
JENKINS_MEMORY_RESERVATION=288m
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Xms128m -Xmx256m -XX:+UseG1GC
JENKINS_AGENT_NAME=idle-game-build-agent
JENKINS_AGENT_LABEL=idle-game-build-agent linux docker
JENKINS_AGENT_REMOTE_FS=/home/jenkins/agent
JENKINS_AGENT_EXECUTORS=1
JENKINS_AGENT_MEMORY_LIMIT=1536m
JENKINS_AGENT_MEMORY_RESERVATION=1024m
