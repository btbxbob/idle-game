FROM 2c6d758624c1b2be1f7e0b7be33b8fb2.d.1ms.run/jenkins/inbound-agent:jdk17

USER root

RUN echo "deb http://mirrors.aliyun.com/debian/ trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian/ trixie-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    echo "deb http://mirrors.aliyun.com/debian-security/ trixie-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    curl \
    ca-certificates \
    git \
    python3 \
    rsync \
    docker-cli \
    docker.io \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    case "$ARCH" in \
      aarch64|arm64) NODE_ARCH='arm64' ;; \
      amd64|x86_64) NODE_ARCH='x64' ;; \
      *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 --retry-connrefused https://nodejs.org/dist/v20.19.5/node-v20.19.5-linux-$NODE_ARCH.tar.gz -o /tmp/node.tar.gz || \
    curl -fsSL --retry 3 --retry-connrefused https://npmmirror.com/mirrors/node/v20.19.5/node-v20.19.5-linux-$NODE_ARCH.tar.gz -o /tmp/node.tar.gz; \
    tar -xzf /tmp/node.tar.gz -C /opt; \
    ln -s /opt/node-v20.19.5-linux-$NODE_ARCH /opt/node; \
    ln -sf /opt/node/bin/node /usr/local/bin/node; \
    ln -sf /opt/node/bin/npm /usr/local/bin/npm; \
    ln -sf /opt/node/bin/npx /usr/local/bin/npx; \
    rm -f /tmp/node.tar.gz

USER jenkins

USER root
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && . /root/.cargo/env \
    && cargo --version \
    && cargo install wasm-bindgen-cli --version 0.2.108 \
    && curl -sSf https://rustwasm.github.io/wasm-pack/installer/init.sh | sh \
    && wasm-pack --version \
    && cp -r /root/.cargo /home/jenkins/ \
    && cp -r /root/.rustup /home/jenkins/ \
    && chown -R jenkins:jenkins /home/jenkins/.cargo /home/jenkins/.rustup \
    && cp -r /root/.cargo-env /home/jenkins/ 2>/dev/null || true
USER jenkins

ENV PATH="/home/jenkins/.cargo/bin:/opt/node/bin:${PATH}"

USER root
COPY docker/jenkins/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod 0755 /usr/local/bin/agent-entrypoint.sh
USER jenkins

ENTRYPOINT ["/usr/local/bin/agent-entrypoint.sh"]
