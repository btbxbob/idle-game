{
  "name": "idle-game-tests",
  "version": "0.8.15",
  "description": "Playwright tests for idle game",
  "scripts": {
    "test": "playwright test",
    "test:quiet": "playwright test --reporter=dot",
    "test:all-browsers": "PW_ALL_BROWSERS=1 playwright test",
    "test:e2e:coverage": "node scripts/run-e2e-coverage.js",
    "test:ui": "playwright test --ui",
    "test:perf": "playwright test tests/functional/performance-budget.test.js",
    "measure:load-time": "node scripts/measure-load-time.js",
    "measure:game-perf": "node scripts/measure-game-perf.js",
    "lint:syntax": "node scripts/lint-syntax.js",
    "lint:version": "node scripts/check-version.js",
    "lint": "npm run lint:syntax && npm run lint:version",
    "precommit": "npm run lint:syntax"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "monocart-coverage-reports": "^2.12.9"
  }
}
