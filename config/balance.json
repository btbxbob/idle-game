  "decay": {
    "maggots_per_corpse": 20,
    "corpse_decay_per_tick": 1.0
  },
  "prestige": {
    "base_threshold": 1000000,
    "pp_formula": "sqrt(total_resources / 1000000) * (1 + tech_count * 0.1 + achievement_count * 0.05)",
    "multiplier_per_pp": 0.01
  },
  "stages": {
    "genesis": { "unlock": "initial", "resources": ["Gold", "Wood", "Stone"] },
    "workers": { "unlock": "total_clicks >= 50", "resources": ["IronOre", "CopperOre", "AluminumOre", "Coal", "Oil", "Crystal", "Food"] },
    "maggot": { "unlock": "corpses >= 1", "resources": ["Corpse", "Maggot"] },
    "hybrid": { "unlock": "maggot_count >= 100 AND symbiotic_tech", "resources": [] },
    "collective": { "unlock": "collective_awakening_tech", "resources": ["DarkMatter", "Spaceship"] }
  },
  "technology_effects": {
    "production_bonus_compound": true,
    "ai_assistance_multiplier": 0.1,
    "nuclear_power_multiplier": 0.1,
    "symbiotic_hosts_multiplier": 0.08,
    "hive_mind_multiplier": 0.12,
    "collective_awakening_multiplier": 0.12,
    "cost_reduction_per_tier4": 0.1,
    "min_cost_multiplier": 0.1
