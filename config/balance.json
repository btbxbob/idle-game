      "working": { "focus_gain": [0.2, 1.0], "fatigue_gain": [0.5, 2.3], "stress_gain": [0.35, 1.35] },
      "idle": { "focus_recovery": 0.8, "fatigue_recovery": -1.4, "stress_recovery": -1.1 }
