  "crafting": {
    "IronIngot": { "inputs": { "IronOre": 10 }, "output": 1 },
    "CopperIngot": { "inputs": { "CopperOre": 10 }, "output": 1 },
    "Chemicals": { "inputs": { "Oil": 4, "Coal": 2 }, "output": 1 },
