    "Robot": { "inputs": { "Crystal": 2, "SteelPlate": 4, "Motor": 2, "Sensor": 2 }, "output": 1 },
    "Nanobot": { "inputs": { "Oil": 5, "Microchip": 2, "Chemicals": 4 }, "output": 1 },
    "Antimatter": { "inputs": { "Crystal": 20, "QuantumComputer": 3, "Chemicals": 10 }, "output": 1 },
    "TimeCrystal": { "inputs": { "Crystal": 40, "Microchip": 10, "QuantumComputer": 2 }, "output": 1 },
